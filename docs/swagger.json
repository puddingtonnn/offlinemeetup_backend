                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Meetups"
                ],
                "summary": "Обновить митап",
                "parameters": [
                    {
                        "type": "integer",
                        "description": "Meetup ID",
                        "name": "id",
                        "in": "path",
                        "required": true
                    },
                    {
                        "description": "Поля для обновления (nil поля игнорируются)",
                        "name": "input",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/dto.UpdateMeetupRequest"
