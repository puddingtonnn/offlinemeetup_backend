	"item": [
		{
			"name": "Auth",
			"item": [
				{
					"name": "Dev Login",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();",
									"if (jsonData.token) {",
									"    pm.environment.set(\"token\", jsonData.token);",
									"    console.log(\"Token automatically saved to environment!\");",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"email\": \"test@example.com\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{baseUrl}}/auth/dev/login?email=test@example.com",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"auth",
								"dev",
								"login"
							],
							"query": [
								{
									"key": "email",
									"value": "test@example.com"
								}
							]
						},
						"description": "Удобный логин для разработки. Создает юзера и возвращает JWT. Автоматически сохраняет токен в переменные."
					},
					"response": []
				},
				{
					"name": "Get Me",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/v1/auth/me",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"v1",
								"auth",
								"me"
							]
						}
					},
					"response": []
				},
				{
					"name": "Register (email/password)",
					"request": {
						"method": "POST",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/v1/auth/register",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"v1",
								"auth",
								"register"
							]
						},
						"body": {
							"mode": "raw",
							"raw": "{\n    \"email\": \"test@example.com\",\n    \"username\": \"testuser\",\n    \"password\": \"SuperSecret123\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"description": "Starts email/password registration. Always returns 202 — even if the email already has an account (Google/Telegram) — and no user row is created until the emailed code is confirmed via Verify Email. The response carries a registration_id identifying THIS attempt; it is saved to the {{registrationId}} collection variable by the test script and must be sent back to Verify Email / Resend Code. Two concurrent registrations on one email get different ids and cannot overwrite each other."
					},
					"response": [],
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"// /register answers 202 with the registration_id that",
									"// /verify-email and /resend-code must echo back. Stash it so the",
									"// next two requests work without copy-pasting.",
									"if (pm.response.code === 202) {",
									"    pm.collectionVariables.set(\"registrationId\", pm.response.json().registration_id);",
									"}"
								]
							}
						}
					]
				},
				{
					"name": "Verify Email",
					"request": {
						"method": "POST",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/v1/auth/verify-email",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"v1",
								"auth",
								"verify-email"
							]
						},
						"body": {
							"mode": "raw",
							"raw": "{\n    \"email\": \"test@example.com\",\n    \"registration_id\": \"{{registrationId}}\",\n    \"code\": \"123456\",\n    \"username\": null\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"description": "Confirms the 6-digit code emailed by Register, creates the account (or attaches the password to an existing one), and returns an access/refresh token pair. `username` is optional — resend a different one only if verify returned 409 (the chosen username was taken in the meantime)."
					},
					"response": [],
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();",
									"if (jsonData.access_token) {",
									"    pm.environment.set(\"token\", jsonData.access_token);",
									"    pm.environment.set(\"refresh_token\", jsonData.refresh_token);",
									"    console.log(\"Tokens automatically saved to environment!\");",
									"}"
								],
								"type": "text/javascript"
							}
						}
					]
				},
				{
					"name": "Resend Code",
					"request": {
						"method": "POST",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/v1/auth/resend-code",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"v1",
								"auth",
								"resend-code"
							]
						},
						"body": {
							"mode": "raw",
							"raw": "{\n    \"email\": \"test@example.com\",\n    \"registration_id\": \"{{registrationId}}\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"description": "Re-sends the confirmation code for a pending registration. Always 202 (rate-limited by cooldown + hourly quota)."
					},
					"response": []
				},
				{
					"name": "Login (email/username + password)",
					"request": {
						"method": "POST",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/v1/auth/login",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"v1",
								"auth",
								"login"
							]
						},
						"body": {
							"mode": "raw",
							"raw": "{\n    \"login\": \"test@example.com\",\n    \"password\": \"SuperSecret123\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"description": "Authenticates with `login` (email or username, detected by presence of '@') and `password`. Unknown login and wrong password return the identical error."
					},
					"response": [],
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();",
									"if (jsonData.access_token) {",
									"    pm.environment.set(\"token\", jsonData.access_token);",
									"    pm.environment.set(\"refresh_token\", jsonData.refresh_token);",
									"    console.log(\"Tokens automatically saved to environment!\");",
									"}"
								],
								"type": "text/javascript"
							}
						}
					]
				},
				{
					"name": "Forgot Password",
					"request": {
						"method": "POST",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/v1/auth/forgot-password",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"v1",
								"auth",
								"forgot-password"
							]
						},
						"body": {
							"mode": "raw",
							"raw": "{\n    \"login\": \"test@example.com\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"description": "Starts a password reset. Always returns 202 regardless of whether the account exists; if it does, a reset code is emailed."
					},
					"response": []
				},
				{
					"name": "Reset Password",
					"request": {
						"method": "POST",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/v1/auth/reset-password",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"v1",
								"auth",
								"reset-password"
							]
						},
						"body": {
							"mode": "raw",
							"raw": "{\n    \"email\": \"test@example.com\",\n    \"code\": \"123456\",\n    \"new_password\": \"NewSuperSecret123\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"description": "Completes a forgot-password flow with the emailed code and a new password. Revokes all refresh tokens for the account."
					},
					"response": []
				},
				{
					"name": "Change Password",
					"request": {
						"method": "PATCH",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/v1/auth/password",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"v1",
								"auth",
								"password"
							]
						},
						"body": {
							"mode": "raw",
							"raw": "{\n    \"current_password\": \"SuperSecret123\",\n    \"new_password\": \"NewSuperSecret123\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"description": "Changes the password of the authenticated caller. `current_password` may be left empty only if the account has no password set yet (Google/Telegram-only account setting its first password). Revokes all other refresh tokens.",
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{token}}",
									"type": "string"
								}
							]
						}
					},
					"response": []
				}
			]
		},
